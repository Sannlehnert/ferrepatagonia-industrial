# Valores publicos para la MariaDB local de compose.yml; no son secretos reales.
# La carga y validación de entorno se ejecuta al inicio mediante Joi (src/config/env.config.ts).
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ferrepatagonia_dev
DB_USER=ferrepatagonia
DB_PASSWORD=ferrepatagonia_dev_only

# Obligatorio: generar un secreto aleatorio privado por entorno (sin fallback).
# Ejemplo de generación: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# HTTP local: origen exacto del navegador/Vite (sin slash final).
# NODE_ENV es obligatorio; valores conocidos: development, test, production.
NODE_ENV=development
APP_PUBLIC_ORIGIN=http://localhost:5173
TRUSTED_PROXY_CIDRS=none
AUTH_RATE_STORE=memory
API_PROCESS_COUNT=1
# Defaults operativos locales, no umbrales productivos acordados.
AUTH_LOGIN_LIMIT=20
AUTH_LOGIN_WINDOW_MS=900000
AUTH_REGISTER_LIMIT=10
AUTH_REGISTER_WINDOW_MS=3600000
# Producción: configurar origen HTTPS real, CIDR de proxies reales, umbrales
# y HTTPS_TERMINATION=trusted-proxy. No reutilizar valores locales como despliegue.
# memory solo sirve para un proceso; escalar requiere un store compartido.
# Desplazamiento histórico de PEDIDO.fecha. Confirmar antes de desplegar en una base existente.
# LEGACY_ORDER_UTC_OFFSET=+00:00

# Directorio privado persistente para comprobantes (#275). Usar una ruta absoluta fuera del checkout.
# RECEIPT_STORAGE_DIR=/var/lib/ferrepatagonia/comprobantes

# Directorio público dedicado a fotos de productos (#285). Crear antes de iniciar.
# Opcional al arrancar; si se define, debe ser una ruta absoluta válida.
# PRODUCT_IMAGE_STORAGE_DIR=/var/lib/ferrepatagonia/fotos-productos

# Directorio opcional para estado de confirmación de importaciones CSV/XLSX.
# Si se omite o queda vacío, se utiliza un subdirectorio temporal del sistema.
# IMPORT_STORAGE_DIR=/var/lib/ferrepatagonia/importaciones
